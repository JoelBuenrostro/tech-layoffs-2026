---
import Layout from "../layouts/Layout.astro";
import "../styles/dashboard.css";
import fs from "fs";
import path from "path";

// ── Leer JSONs ──
const dataDir = path.join(process.cwd(), "public", "data");

// eslint-disable-next-line @typescript-eslint/no-explicit-any
function readJSON(file: string, fallback: any): any {
  try {
    return JSON.parse(fs.readFileSync(path.join(dataDir, file), "utf-8"));
  } catch {
    console.warn(
      `Archivo no encontrado: ${file} — corre python3 scripts/process_data.py`,
    );
    return fallback;
  }
}

const summary = readJSON("summary.json", {
  total_jobs_cut: 0,
  total_companies: 0,
  ai_cited_pct: 0,
  top_quarter: "—",
  data_as_of: "—",
});
const byMonth      = readJSON("by_month.json",    []);
const bySector     = readJSON("by_sector.json",   []);
const byRegion     = readJSON("by_region.json",   []);
const topCompanies = readJSON("top_companies.json",[]);
const cumulative   = readJSON("cumulative.json",  []);
const detail       = readJSON("detail.json",      []);
const topRoles     = readJSON("top_roles.json",   []);

const maxRoleCount: number = topRoles[0]?.count ?? 1;
---

<Layout title="Tech Layoffs 2026 | Dashboard">
  <div class="app">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <svg width="20" height="20" viewBox="0 0 32 32" fill="none">
          <polyline points="3,24 10,16 17,20 26,9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="21,9 26,9 26,14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <nav class="sidebar-nav">
        <a href="#kpis" class="nav-item active" title="Dashboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
        </a>
        <a href="#tabla" class="nav-item" title="Tabla de datos">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 10h18M3 14h18M10 3v18M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6z"/>
          </svg>
        </a>
        <a href="#roles" class="nav-item" title="Roles afectados">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </a>
      </nav>
      <a href="https://www.linkedin.com/in/joelbuenrostro" target="_blank" rel="noopener" class="sidebar-footer" title="Joel Buenrostro">
        JB
      </a>
    </aside>

    <!-- Content -->
    <div class="content-wrapper">

      <!-- Header -->
      <header class="header">
        <div class="header-brand">
          <div>
            <h1>Tech Layoffs <span class="year-accent">2026</span></h1>
            <p class="subtitle">Análisis de despidos en la industria tecnológica</p>
          </div>
        </div>
        <div class="header-meta">
          <span class="live-dot"></span>
          <span class="badge-date">Actualizado: {summary.data_as_of ?? "—"}</span>
        </div>
      </header>

  <main class="main">
    <!-- KPI Cards -->
    <section id="kpis" class="kpi-grid">
      <div class="kpi-card kpi-1">
        <div class="kpi-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
              cx="9"
              cy="7"
              r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
              d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
          >
        </div>
        <span class="kpi-label">Total empleos perdidos</span>
        <span class="kpi-value"
          >{summary.total_jobs_cut?.toLocaleString("es-MX") ?? "—"}</span
        >
        <span class="kpi-sub">en {summary.total_companies} empresas</span>
      </div>

      <div class="kpi-card kpi-2">
        <div class="kpi-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><rect x="2" y="7" width="20" height="14" rx="2"></rect><path
              d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg
          >
        </div>
        <span class="kpi-label">Empresas afectadas</span>
        <span class="kpi-value">{summary.total_companies ?? "—"}</span>
        <span class="kpi-sub">en múltiples sectores</span>
      </div>

      <div class="kpi-card kpi-3">
        <div class="kpi-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"
            ></path></svg
          >
        </div>
        <span class="kpi-label">Casos con IA citada</span>
        <span class="kpi-value">{summary.ai_cited_pct ?? "—"}%</span>
        <span class="kpi-sub">como causa directa</span>
      </div>

      <div class="kpi-card kpi-4">
        <div class="kpi-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
          >
        </div>
        <span class="kpi-label">Trimestre más activo</span>
        <span class="kpi-value">{summary.top_quarter ?? "—"}</span>
        <span class="kpi-sub">mayor concentración</span>
      </div>
    </section>

    <!-- Acumulado anual -->
    <section class="chart-card">
      <div class="chart-card-header">
        <h2>Despidos acumulados 2026</h2>
        <span class="chart-badge">Tendencia anual</span>
      </div>
      <canvas id="chartCumulative"></canvas>
    </section>

    <!-- Charts fila 1 -->
    <section class="charts-grid">
      <div class="chart-card">
        <div class="chart-card-header">
          <h2>Empleos perdidos por mes</h2>
          <span class="chart-badge">Barras</span>
        </div>
        <canvas id="chartMonth"></canvas>
      </div>
      <div class="chart-card">
        <div class="chart-card-header">
          <h2>Distribución por sector</h2>
          <span class="chart-badge">Anillo</span>
        </div>
        <canvas id="chartSector"></canvas>
      </div>
    </section>

    <!-- Charts fila 2 -->
    <section class="charts-grid">
      <div class="chart-card">
        <div class="chart-card-header">
          <h2>Distribución por región</h2>
          <span class="chart-badge">Circular</span>
        </div>
        <canvas id="chartRegion"></canvas>
      </div>
      <div class="chart-card">
        <div class="chart-card-header">
          <h2>Top 10 empresas</h2>
          <span class="chart-badge">Clasificación</span>
        </div>
        <canvas id="chartCompanies"></canvas>
      </div>
    </section>

    <!-- Roles más afectados -->
    <section id="roles" class="card roles-section">
      <div class="section-header">
        <h2>Roles más afectados</h2>
        <p class="section-desc">
          Cargos que concentraron el mayor volumen de despidos según fuentes
          verificadas
        </p>
      </div>
      <div class="roles-grid">
        {
          (topRoles as any[]).map((r: any, i: number) => {
            const intensity = Math.round((r.count / maxRoleCount) * 100);
            return (
              <div class="role-pill" style={`--intensity: ${intensity}`}>
                <span class="role-rank">#{i + 1}</span>
                <span class="role-name">{r.role}</span>
                {r.count > 1 && <span class="role-count">{r.count}</span>}
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Tabla interactiva -->
    <section id="tabla" class="card table-section">
      <div class="section-header">
        <div>
          <h2>Detalle por empresa</h2>
          <p class="section-desc">
            Filtra y explora el registro completo de despidos
          </p>
        </div>
      </div>

      <div class="filters-bar">
        <div class="search-wrap">
          <svg
            class="search-icon"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
            ></path></svg
          >
          <input id="searchInput" type="text" placeholder="Buscar empresa…" />
        </div>
        <select id="filterSector">
          <option value="">Todos los sectores</option>
          {
            (
              Array.from(
                new Set((detail as any[]).map((d: any) => d.sector)),
              ) as string[]
            )
              .sort()
              .map((s) => <option value={s as string}>{s}</option>)
          }
        </select>
        <select id="filterRegion">
          <option value="">Todas las regiones</option>
          {
            (
              Array.from(
                new Set((detail as any[]).map((d: any) => d.region)),
              ) as string[]
            )
              .sort()
              .map((r) => <option value={r as string}>{r}</option>)
          }
        </select>
        <select id="filterAI">
          <option value="">IA: todos</option>
          <option value="true">IA citada</option>
          <option value="false">Sin IA</option>
        </select>
        <select id="filterType">
          <option value="">Todas las empresas</option>
          <option value="Pública">Pública</option>
          <option value="Privada">Privada</option>
        </select>
        <span id="tableCount" class="filter-count"></span>
      </div>

      <div class="table-wrap">
        <table id="mainTable">
          <thead>
            <tr>
              <th>Empresa</th>
              <th>Tipo</th>
              <th>Fecha</th>
              <th class="th-right">Empleos</th>
              <th>Sector</th>
              <th>Región</th>
              <th>IA</th>
              <th>Bolsa</th>
              <th>Razón declarada</th>
            </tr>
          </thead>
          <tbody>
            {
              (detail as any[]).map((row: any) => (
                <tr
                  data-company={row.company?.toLowerCase()}
                  data-sector={row.sector}
                  data-region={row.region}
                  data-ai={String(row.ai_cited)}
                  data-type={row.company_type}
                >
                  <td class="td-company">{row.company}</td>
                  <td>
                    <span class={`tag ${row.company_type === "Pública" ? "tag-type-public" : "tag-type-private"}`}>
                      {row.company_type === "Pública" ? "Pública" : "Privada"}
                    </span>
                  </td>
                  <td class="td-date">{row.layoff_date}</td>
                  <td class="td-num">
                    {row.jobs_cut?.toLocaleString("es-MX")}
                  </td>
                  <td class="td-muted">{row.sector}</td>
                  <td class="td-muted">{row.region}</td>
                  <td>
                    <span
                      class={`tag ${row.ai_cited ? "tag-ai-yes" : "tag-ai-no"}`}
                    >
                      {row.ai_cited ? "Sí" : "No"}
                    </span>
                  </td>
                  <td>
                    {row.stock === "Positiva" && <span class="tag tag-stock-positiva">↑ Sube</span>}
                    {row.stock === "Negativa" && <span class="tag tag-stock-negativa">↓ Baja</span>}
                    {(row.stock === "Neutral" || !row.stock || row.stock === "N/A" || row.stock === "N/D") && <span class="tag tag-stock-neutral">— Neutral</span>}
                  </td>
                  <td class="td-reason">
                    {row.reason && <span>{row.reason}</span>}
                    {row.source?.startsWith('http') && (
                      <a href={row.source} target="_blank" rel="noopener" class="source-link">
                        {row.reason ? "Ver fuente" : "Ver publicación"}
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="link-icon"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      </a>
                    )}
                    {!row.reason && !row.source?.startsWith('http') && (
                      <span class="td-empty">
                        {row.source ? row.source : "—"}
                      </span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </main>

      <footer class="footer">
        <div class="footer-inner">
          <span>Proyecto de análisis de datos</span>
          <span class="footer-sep">·</span>
          <a href="https://www.linkedin.com/in/joelbuenrostro" target="_blank" rel="noopener">Joel Buenrostro</a>
          <span class="footer-sep">·</span>
          <span>Datos actualizados mensualmente</span>
        </div>
      </footer>

    </div><!-- /content-wrapper -->
  </div><!-- /app -->
</Layout>

<!-- Datos del servidor serializados para el cliente -->
<script
  type="application/json"
  id="chart-data"
  set:html={JSON.stringify({ byMonth, bySector, byRegion, topCompanies, cumulative })}
/>

<!-- Entry point del dashboard -->
<script>
  import "../scripts/main";
</script>
